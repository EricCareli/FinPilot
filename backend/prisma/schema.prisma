generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceType {
  PERSONAL
  BUSINESS
}

enum WorkspaceRole {
  OWNER
  ADMIN
  FINANCE
  VIEWER
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  CREDIT_CARD
  INVESTMENT
  OTHER
}

enum AccountStatus {
  ACTIVE
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  REFUND
  ADJUSTMENT
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum TransactionStatus {
  PENDING
  POSTED
  VOIDED
}

enum Currency {
  BRL
  USD
  EUR
}

enum CreditCardInvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMemberships WorkspaceMember[]

  @@map("users")
}

model Workspace {
  id        String        @id @default(uuid())
  name      String
  type      WorkspaceType
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  members      WorkspaceMember[]
  accounts     Account[]
  categories   Category[]
  transactions FinancialTransaction[]
  budgets      Budget[]
  goals        Goal[]

  @@index([type])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@map("workspace_members")
}

model Account {
  id             String        @id @default(uuid())
  workspaceId    String
  name           String
  type           AccountType
  status         AccountStatus @default(ACTIVE)
  currency       Currency      @default(BRL)
  initialBalance Decimal       @default(0) @db.Decimal(19, 4)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace  Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  creditCard CreditCard?

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("accounts")
}

model CreditCard {
  id          String   @id @default(uuid())
  accountId   String   @unique
  creditLimit Decimal  @db.Decimal(19, 4)
  closingDay  Int
  dueDay      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account  Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoices CreditCardInvoice[]

  @@map("credit_cards")
}

model CreditCardInvoice {
  id             String                  @id @default(uuid())
  creditCardId   String
  referenceMonth Int
  referenceYear  Int
  closingDate    DateTime
  dueDate        DateTime
  totalAmount    Decimal                 @default(0) @db.Decimal(19, 4)
  status         CreditCardInvoiceStatus @default(OPEN)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  creditCard CreditCard @relation(fields: [creditCardId], references: [id], onDelete: Cascade)

  @@unique([creditCardId, referenceMonth, referenceYear])
  @@index([creditCardId])
  @@index([creditCardId, status])
  @@map("credit_card_invoices")
}

model Category {
  id          String          @id @default(uuid())
  workspaceId String
  name        String
  type        TransactionType
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  transactions FinancialTransaction[]
  budgets      Budget[]

  @@unique([workspaceId, name, type])
  @@index([workspaceId])
  @@map("categories")
}

model FinancialTransaction {
  id              String            @id @default(uuid())
  workspaceId     String
  categoryId      String?
  type            TransactionType
  status          TransactionStatus @default(POSTED)
  description     String
  transactionDate DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  entries   LedgerEntry[]

  @@index([workspaceId])
  @@index([workspaceId, transactionDate])
  @@index([categoryId])
  @@map("financial_transactions")
}

model LedgerEntry {
  id            String          @id @default(uuid())
  transactionId String
  accountId     String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(19, 4)
  createdAt     DateTime        @default(now())

  transaction FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model Budget {
  id          String   @id @default(uuid())
  workspaceId String
  categoryId  String
  amount      Decimal  @db.Decimal(19, 4)
  month       Int
  year        Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([workspaceId, categoryId, month, year])
  @@index([workspaceId])
  @@index([categoryId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(uuid())
  workspaceId   String
  name          String
  targetAmount  Decimal   @db.Decimal(19, 4)
  currentAmount Decimal   @default(0) @db.Decimal(19, 4)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("goals")
}
